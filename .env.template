# Copy to .env and fill in. Only COOKIE is required.

# Your adventofcode.com session cookie. Log in, open dev tools, and copy the
# value of the cookie named `session`. Personal to your account, so .env is
# gitignored.
COOKIE=

# An address AOC can reach you at. Folded into the User-Agent, because the site
# asks automated clients to be contactable. Optional, and left out of the source
# so a fork identifies its own owner.
CONTACT=

# The repo reported in the User-Agent. Optional, with no default, so leaving it
# blank never points AOC at somebody else's repo for your traffic.
REPO_URL=
